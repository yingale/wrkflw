{
  "metadata": {
    "id": "e8348273-bc46-4723-85cb-f62a7179a467",
    "name": "Home Loan Repayment Processing",
    "description": "Automated workflow for processing home loan repayment emails and creating cases for team resolution",
    "category": "Finance",
    "version": "1.0.1",
    "createdAt": "2026-01-22T04:53:40.091Z",
    "updatedAt": "2026-01-22T04:53:40.091Z"
  },
  "nodes": [
    {
      "id": "trigger-1",
      "type": "trigger",
      "label": "Schedule Trigger",
      "description": "Runs daily at 5:00 AM",
      "position": {
        "x": 250,
        "y": 100
      }
    },
    {
      "id": "action-1",
      "type": "action",
      "label": "Read Mailbox",
      "description": "Fetch emails from configured mailbox",
      "position": {
        "x": 250,
        "y": 220
      }
    },
    {
      "id": "condition-1",
      "type": "condition",
      "label": "Match Keywords",
      "description": "Filter emails containing: payment, repayment, loan, EMI",
      "position": {
        "x": 250,
        "y": 340
      }
    },
    {
      "id": "action-2",
      "type": "action",
      "label": "Create Case",
      "description": "Create case for loan processing team",
      "position": {
        "x": 250,
        "y": 460
      }
    },
    {
      "id": "action-3",
      "type": "action",
      "label": "Assign to Team",
      "description": "Auto-assign based on case priority",
      "position": {
        "x": 250,
        "y": 580
      }
    },
    {
      "id": "end-1",
      "type": "end",
      "label": "End",
      "position": {
        "x": 250,
        "y": 700
      }
    }
  ],
  "connections": [
    {
      "id": "flow-1",
      "from": "trigger-1",
      "to": "action-1"
    },
    {
      "id": "flow-2",
      "from": "action-1",
      "to": "condition-1"
    },
    {
      "id": "flow-3",
      "from": "condition-1",
      "to": "action-2",
      "label": "Match"
    },
    {
      "id": "flow-4",
      "from": "action-2",
      "to": "action-3"
    },
    {
      "id": "flow-5",
      "from": "action-3",
      "to": "end-1"
    },
    {
      "id": "flow-skip",
      "from": "condition-1",
      "to": "end-1",
      "label": "No Match"
    }
  ],
  "personas": [
    {
      "id": "Participant_LoanOfficer",
      "name": "Loan Officer",
      "role": "processor",
      "permissions": [
        "view",
        "edit",
        "resolve"
      ]
    },
