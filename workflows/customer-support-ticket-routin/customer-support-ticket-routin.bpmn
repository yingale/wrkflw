<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL"
                  xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI"
                  xmlns:dc="http://www.omg.org/spec/DD/20100524/DC"
                  xmlns:camunda="http://camunda.org/schema/1.0/bpmn"
                  id="Definitions_1"
                  targetNamespace="http://bpmn.io/schema/bpmn">
  <bpmn:process id="daafef89-a15d-4aa6-adb3-16231a5e2266" name="Customer Support Ticket Routing" isExecutable="true">
    <bpmn:startEvent id="trigger-1" name="New Ticket" />
    <bpmn:exclusiveGateway id="condition-1" name="Categorize" />
    <bpmn:task id="action-1" name="Assign Technical" />
    <bpmn:endEvent id="end-1" name="End" />
    <bpmn:task id="action-2" name="Assign Billing" />
    <bpmn:sequenceFlow id="flow_0" sourceRef="trigger-1" targetRef="condition-1" />
    <bpmn:sequenceFlow id="flow_1" sourceRef="condition-1" targetRef="action-1" />
    <bpmn:sequenceFlow id="flow_2" sourceRef="condition-1" targetRef="action-2" />
    <bpmn:sequenceFlow id="flow_3" sourceRef="action-1" targetRef="end-1" />
    <bpmn:sequenceFlow id="flow_4" sourceRef="action-2" targetRef="end-1" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_1">
    <bpmndi:BPMNPlane id="BPMNPlane_1" bpmnElement="daafef89-a15d-4aa6-adb3-16231a5e2266">
      <bpmndi:BPMNShape id="trigger-1_di" bpmnElement="trigger-1">
        <dc:Bounds x="100" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="condition-1_di" bpmnElement="condition-1">
        <dc:Bounds x="300" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="action-1_di" bpmnElement="action-1">
        <dc:Bounds x="500" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="end-1_di" bpmnElement="end-1">
        <dc:Bounds x="700" y="100" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="action-2_di" bpmnElement="action-2">
        <dc:Bounds x="100" y="250" width="100" height="80" />
      </bpmndi:BPMNShape>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>